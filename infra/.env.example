# Copy this file to infra/.env.staging or infra/.env.production and fill in the values.
# These variables are loaded by the Makefile when running `make sam-deploy ENV=<env>`.

ECR_IMAGE_URI=
DATA_HUB_API_URL=
DATA_HUB_API_KEY=
GITHUB_OIDC_PROVIDER_ARN=
VERCEL_OIDC_PROVIDER_ARN=
# IAM role ARN pattern of the principal that runs admin deploys (wildcards
# allowed), exempted from the bucket-configuration deny. Use the role ARN form,
# not the sts::assumed-role session form — for SSO roles, discover it with
# `aws iam list-roles --path-prefix /aws-reserved/sso.amazonaws.com/`, e.g.
# arn:aws:iam::<acct>:role/aws-reserved/sso.amazonaws.com/*/AWSReservedSSO_<PermissionSet>_*
ADMIN_DEPLOY_PRINCIPAL_ARN=
# "true" puts the Lambda in a VPC with a NAT gateway (about $39/month) so it
# can mount the raw bucket. Leave "false" unless you need files larger than
# the Lambda disk. An empty value fails the deploy on purpose, so a missing
# variable cannot turn an existing network off.
ENABLE_S3_FILES=false
# Optional. Processing alarms email this address after it confirms the
# subscription. Leave empty for no email.
ALARM_EMAIL=
