# Public production URL of the docs site. Used to build absolute URLs for
# metadata, Open Graph, the sitemap, and robots.txt.
NEXT_PUBLIC_SITE_URL=https://docs.example.com

# Vercel AI Gateway credentials for the "Ask AI" chat widget. On Vercel this is
# provided automatically via OIDC, so no key is needed in that environment.
# For local development or non-Vercel hosts, set an AI Gateway API key.
AI_GATEWAY_API_KEY=

# Optional: override the default chat model id (any AI Gateway model slug).
# AI_GATEWAY_MODEL=anthropic/claude-3.5-sonnet
