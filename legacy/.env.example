# Local directory to download data to.
# Lambda provides ephemeral storage for functions in the /tmp directory,
# but we don't want to use /tmp for local development and testing.
LOCAL_DATA_DIRPATH="data/"

# The region and names of the S3 buckets where raw and processed data will be stored.
AWS_REGION=
AWS_S3_RAW_DATA_BUCKET=
AWS_S3_PROCESSED_DATA_BUCKET=

# These AWS credentials must correspond to an IAM user with:
# - read/write access to the S3 bucket above
# - access to push images to the ECR repository
# - access to update the Lambda function code
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# This token is used to authenticate requests to the publicly accessible Lambda function URL.
AWS_LAMBDA_FUNCTION_URL_AUTH_TOKEN=

# Ganymede.
GANYMEDE_API_KEY=

# This is an API token with integration permissions set for the "Data Hub" Notion page.
# It must be created by a Notion workspace owner.
# See: https://developers.notion.com/docs/create-a-notion-integration#getting-started.
NOTION_API_SECRET=

# This is the ID of the "Data Hub" Notion page. It can be found by navigating to the Notion page,
# clicking Share > Copy link and copying the ID from the URL.
NOTION_PAGE_ID=

# This token provides read access to a selection of Arcadia's private GitHub repositories, which
# allows us to `pip install` packages in those repos from GitHub Actions runners and AWS Lambda functions.
GH_PERSONAL_ACCESS_TOKEN=

# This is the Slack webhook URL for the channel to send messages to on workflow completion.
# See: https://docs.slack.dev/messaging/sending-messages-using-incoming-webhooks/.
SLACK_WEBHOOK_URL=