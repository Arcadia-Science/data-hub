# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# Next 16 used to write Turbopack assets into a nested copy of this
# directory when `turbopack.root` walked up to the git repo. Keep any
# leftover folder out of git status.
/web/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env files
.env
.env*.local

# typescript
*.tsbuildinfo
next-env.d.ts
.vercel

# Local OpenAPI dump from `npm run openapi:generate` (not committed;
# production serves the schema from GET /api/v1/openapi.json).
/openapi.json
# Optional local dump from `npm run mcp-catalog:generate` (same idea;
# production serves GET /mcp/v1/schema.json).
/mcp-catalog.json

# Self-contained MCP Apps View (built by `npm run mcp-apps:build`).
/mcp-apps/dist/
