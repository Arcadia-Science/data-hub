# Public docs site base URL. Defaults to https://arcadia-data-hub-docs.vercel.app
# when unset.
# DOCS_BASE_URL=

# Database.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/data-hub-local

# Authentication.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=

# AWS — OIDC federation on Vercel, default credential chain locally.
AWS_REGION=us-west-1
AWS_ROLE_ARN=

# S3 bucket for raw instrument data uploads.
S3_RAW_DATA_BUCKET=arcadia-data-hub-raw-staging

# S3 bucket for cached run-archive zips (built by the Lambda, served via
# presigned GET URLs).
S3_ARCHIVES_BUCKET=arcadia-data-hub-archives-staging

# Lambda Function URL. The web app POSTs S3 reprocess events and
# archive-build requests here, SigV4-signed using the credentials
# resolved via AWS_ROLE_ARN (Vercel OIDC) or the default credential
# chain (local dev). Required for run-archive downloads.
LAMBDA_FUNCTION_URL=

# Slack bot / personal DM notifications.
# Create a Slack app at https://api.slack.com/apps, add a bot user with the
# `chat:write` scope, install it to the workspace, and copy the bot token.
# The OAuth credentials enable users to connect their personal Slack account
# via "Sign in with Slack" on the Settings > Notifications page so the bot
# can DM them. SLACK_TEAM_ID optionally restricts which workspace users can
# link (recommended for single-tenant deployments).
SLACK_BOT_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Optional: dedicated signing secret for OAuth state tokens. Falls back to
# AUTH_SECRET when unset.
SLACK_STATE_SECRET=
# Optional: override the redirect URI registered in the Slack app config.
# Defaults to <request-origin>/api/v1/settings/slack/callback.
# SLACK_REDIRECT_URI=
# Optional: restrict OAuth connections to a specific Slack workspace ID.
# SLACK_TEAM_ID=

# Shared secret for Vercel Cron jobs. Vercel sends it as `Authorization:
# Bearer <CRON_SECRET>` on scheduled invocations (see web/vercel.json). The
# upload-queue sweep rejects requests without it, so it must be set in the
# Vercel project env (staging + production). Not needed for local dev unless
# you invoke /api/cron/* by hand.
CRON_SECRET=

# Optional: local S3 mirror for dev. When set (and NODE_ENV != production),
# the four helpers in `lib/s3.ts` short-circuit AWS and serve bytes from
# this directory via `/api/local-s3/{bucket}/{key}` instead. The seed
# also copies fixture files from `lambda/tests/fixtures/` into the
# mirror for qPCR / gel doc / plate reader so seeded runs render real
# bytes immediately. Path is resolved relative to web/. See
# developer-docs/local-development.md.
# LOCAL_S3_MIRROR=../lambda/.local-s3
