{
  "name": "data-hub-web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint:check": "ultracite check",
    "lint:fix": "ultracite fix",
    "typecheck": "tsc --noEmit",
    "precommit": "npm run lint:fix && npm run typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:reset": "tsx scripts/reset-database.ts",
    "db:seed": "tsx scripts/seed-database.ts",
    "db:reseed": "npm run db:reset && npm run db:push && npm run db:seed",
    "db:process-fixtures": "tsx scripts/process-seeded-fixtures.ts",
    "db:clear-runs": "tsx scripts/clear-run-file-records.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:unit:watch": "vitest --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "check": "npm run lint:check && npm run typecheck",
    "check-all": "npm run check && npm run test-all && npm run build"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.1",
    "@aws-sdk/client-s3": "^3.1021.0",
    "@aws-sdk/s3-request-presigner": "^3.1021.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@slack/web-api": "^7.17.0",
    "@smithy/hash-node": "^4.3.1",
    "@smithy/protocol-http": "^5.4.1",
    "@smithy/signature-v4": "^5.4.1",
    "@tanstack/react-form": "^1.32.0",
    "@vercel/functions": "^3.7.3",
    "@vercel/microfrontends": "^2.4.0",
    "@vercel/oidc-aws-credentials-provider": "^3.0.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "csv-parse": "^6.2.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.7.0",
    "mcp-handler": "^1.1.0",
    "next": "^16.2.4",
    "next-auth": "^5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.9",
    "pg": "^8.22.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.1.1",
    "shiki": "^4.0.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "ultracite": "^7.8.3",
    "vitest": "^4.1.2"
  }
}
